+def require(condition, label):
+    if not condition:
+        raise ValueError("INVALID_EVIDENCE_SHAPE:" + label)
+
+
+def object_shape(value, label):
+    require(type(value) is dict, label)
+    return value
+
+
+def rows_shape(value, label, count):
+    require(type(value) is list and len(value) == count, label)
+    require(all(type(row) is dict for row in value), label + ":rows")
+    return value
+
+
+def text(value):
+    return type(value) is str and bool(value)
+
+
+def hash_shape(value):
+    return type(value) is str and re.fullmatch(r"[0-9a-f]{64}", value) is not None
+
+
+def safe_child(parent, name):
+    require(type(name) is str and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", name) is not None,
+            "single_filename")
+    candidate = parent / name
+    require(candidate.resolve().is_relative_to(parent.resolve()), "path_containment")
+    return candidate
+
+
+def unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        require(key not in result, "duplicate_json_key")
+        result[key] = value
+    return result
+
+
+def invalid_constant(value):
+    raise ValueError("INVALID_JSON_CONSTANT:" + value)
+
+
+def decode(raw):
+    return json.loads(raw, object_pairs_hook=unique_object, parse_constant=invalid_constant)
+
+
