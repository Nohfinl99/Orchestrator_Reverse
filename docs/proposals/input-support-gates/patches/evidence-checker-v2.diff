+    result["status"] = "VALID_RECORDED_EVIDENCE" if result["passed_readback"] else "RECORDED_EVIDENCE_MISMATCH"
+    (OUT / "verification.json").write_text(
+        json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8", newline="\n")
+    print(json.dumps({"status": result["status"], "passed_readback": result["passed_readback"],
+                      "captures": len(capture_checks), "historical_cases": len(case_checks),
+                      "new_workload_runs": 0}))
+    return 0 if result["passed_readback"] else 1
 
